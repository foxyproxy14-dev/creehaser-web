# Copia este archivo como .env y rellénalo:   cp .env.example .env
# NUNCA subas el .env al repositorio.

# --- Django ---
# Genera una clave larga y aleatoria con:  openssl rand -base64 48
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=false
# Tu dominio (y la IP de la VM si quieres probar por IP), separados por coma
DJANGO_ALLOWED_HOSTS=navidad.tudominio.com,192.168.1.50,localhost
# Dirección pública con https:// (necesario para los formularios)
DJANGO_CSRF_TRUSTED_ORIGINS=https://navidad.tudominio.com
# Pon false SOLO si vas a probar por http://IP sin HTTPS
DJANGO_SECURE_COOKIES=true

# --- Base de datos ---
POSTGRES_DB=creehaser
POSTGRES_USER=creehaser
# Genera una con:  openssl rand -base64 24
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Puerto donde escucha esta VM (al que apunta tu proxy inverso) ---
HTTP_PORT=8080

# --- Correo (parte 4: certificados y avisos) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Fundación CreeHaSer <no-responder@tudominio.com>

# --- Telegram (parte 4: avisos a organizadores) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
